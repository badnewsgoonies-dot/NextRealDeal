{
  "name": "nextrealdeal",
  "version": "1.0.0",
  "description": "Production-ready headless game engine for battle-first roguelikes with deterministic gameplay, cross-platform save/load, and comprehensive testing",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md",
    "API.md",
    "EXAMPLES.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "circular": "madge --circular --extensions ts src/",
    "deps": "depcruise --config .dependency-cruiser.cjs src/",
    "ci": "npm run lint && npm run circular && npm run deps && npm run test:coverage",
    "perf": "tsx scripts/perf.ts",
    "gen": "plop",
    "demo": "tsx examples/simple-demo/demo.ts",
    "dev": "vite",
    "build:web": "vite build",
    "preview": "vite preview"
  },
  "keywords": [
    "game-engine",
    "roguelike",
    "typescript",
    "deterministic",
    "turn-based",
    "tactical",
    "headless",
    "battle-tower",
    "slay-the-spire",
    "procedural-generation",
    "game-development",
    "bsp",
    "save-system"
  ],
  "author": "NextRealDeal Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/NextRealDeal.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/NextRealDeal/issues"
  },
  "homepage": "https://github.com/yourusername/NextRealDeal#readme",
  "dependencies": {
    "@tailwindcss/postcss": "^4.1.14",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "pure-rand": "^6.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.4",
    "tailwindcss": "^4.1.14",
    "valibot": "^0.42.1",
    "vite": "^5.4.20",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.18.10",
    "@typescript-eslint/eslint-plugin": "^8.46.1",
    "@typescript-eslint/parser": "^8.46.1",
    "@vitest/coverage-v8": "^2.1.9",
    "dependency-cruiser": "^16.10.4",
    "eslint": "^9.37.0",
    "fast-check": "^3.23.2",
    "madge": "^8.0.0",
    "plop": "^4.0.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
